    <string name="pair_title">Pair MahiRoute with this phone</string>
    <string name="pair_instructions">1. Open Developer options → Wireless debugging.
2. Tap “Pair device with pairing code”.
3. Type the six digits shown there below, or in the notification. This is needed only once.</string>
    <string name="pair_code_hint">Pairing code</string>
