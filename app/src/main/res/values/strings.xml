    <!-- Helper -->
    <string name="helper_title">Helper is not running</string>
    <string name="helper_body">Android only lets the system choose audio devices. MahiRoute starts a small helper with debugging rights to change that. It only needs a Wi-Fi connection, and that network does not need internet access: any network works, even one without a route to the internet. Wi-Fi is needed just to start; once running the helper works offline until the phone restarts.</string>
    <string name="helper_connecting">Connecting to the helper…</string>
    <string name="helper_start">Start helper</string>
    <string name="helper_failed">Cannot reach the helper: %1$s</string>
    <string name="pc_toggle">Start from a computer (no Wi-Fi)</string>
    <string name="pc_hint">Save the Windows file, move it to the computer and double-click it while the phone is connected by USB with USB debugging on. It finds adb, waits for the phone and asks you to press Enter. The app connects to the helper by itself.</string>
    <string name="pc_save_launcher">Save the Windows file</string>
    <string name="pc_launcher_saved">MahiRoute-start.bat was saved to the Downloads folder</string>
    <string name="pc_launcher_failed">Could not save the file</string>
    <string name="pc_manual_hint">Or run the command on the computer by hand:</string>
